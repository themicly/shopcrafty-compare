{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "themicly/shopcrafty-compare",
    "description": "Compare add-on for Shopcrafty.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Themicly",
            "homepage": "https://themicly.com"
        },
        {
            "name": "Md. Rakibul Islam",
            "homepage": "https://github.com/rakibdevs"
        }
    ],
    "require": {
        "php": "^8.3",
        "themicly/shopcrafty": "dev-main@dev",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Themicly\\Shopcrafty\\Compare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Themicly\\Shopcrafty\\Compare\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Themicly\\Shopcrafty\\Compare\\CompareServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
